// Members.razor

@page "/members"
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@using Microsoft.EntityFrameworkCore
@inject LibraryContext Db

<h3>Medlemmar</h3>

@if (members == null)
{
    <p>Laddar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Member ID</th>
                <th>Namn</th>
                <th>Email</th>
                <th>Medlem sedan</th>
                <th>Aktiva lån</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in members)
            {
                <tr>
                    <td>@member.MemberId</td>
                    <td>@member.Name</td>
                    <td>@member.Email</td>
                    <td>@member.MemberSince.ToShortDateString()</td>
                    <td>@member.Loans.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    List<Member>? members;

    protected override async Task OnInitializedAsync()
    {
        members = await Db.Members
            .Include(m => m.Loans)
            .ToListAsync();
    }

}