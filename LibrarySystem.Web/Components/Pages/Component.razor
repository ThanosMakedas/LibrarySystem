@page "/books"
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@using Microsoft.EntityFrameworkCore
@inject LibraryContext Db

<h3>Böcker</h3>

@if (books == null)
{
    <p>Laddar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>Titel</th>
                <th>Författare</th>
                <th>År</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.ISBN</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishedYear</td>
                    <td>@(book.IsAvailable ? "Tillgänglig" : "Utlånad")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    List<Book>? books;

    protected override async Task OnInitializedAsync()
    {
        books = await Db.Books.ToListAsync();
    }

}