@page "/books/edit/{id:int}"
@rendermode InteractiveServer
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@inject LibraryContext Db
@inject NavigationManager Nav

<h3>Redigera bok</h3>

@if (book == null)
{
    <p>Laddar...</p>
}
else
{
    <EditForm Model="book" OnValidSubmit="HandleSubmit" FormName="EditBookForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>ISBN</label>
            <InputText class="form-control" @bind-Value="book.ISBN" />
        </div>

        <div class="mb-3">
            <label>Titel</label>
            <InputText class="form-control" @bind-Value="book.Title" />
        </div>

        <div class="mb-3">
            <label>Författare</label>
            <InputText class="form-control" @bind-Value="book.Author" />
        </div>

        <div class="mb-3">
            <label>Publiceringsår</label>
            <InputNumber class="form-control" @bind-Value="book.PublishedYear" />
        </div>

        <button type="submit" class="btn btn-primary">Spara</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Book? book;

    protected override async Task OnInitializedAsync()
    {
        book = await Db.Books.FindAsync(Id);
    }

    private async Task HandleSubmit()
    {
        if (book == null)
            return;

        Db.Books.Update(book);
        await Db.SaveChangesAsync();

        Nav.NavigateTo("/books");
    }
}