// EditBook.razor

@page "/books/edit/{Id:int}"
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@using Microsoft.EntityFrameworkCore
@inject LibraryContext Db
@inject NavigationManager Nav

<h3>Redigera bok</h3>

@if (book == null)
{
    <p>Laddar...</p>
}
else
{
    <EditForm Model="@book" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>ISBN</label>
            <InputText class="form-control" @bind-Value="book.ISBN" />
        </div>

        <div class="mb-3">
            <label>Titel</label>
            <InputText class="form-control" @bind-Value="book.Title" />
        </div>

        <div class="mb-3">
            <label>Författare</label>
            <InputText class="form-control" @bind-Value="book.Author" />
        </div>

        <div class="mb-3">
            <label>Publiceringsår</label>
            <InputNumber class="form-control" @bind-Value="book.PublishedYear" />
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="book.IsAvailable" />
            <label class="form-check-label">Tillgänglig</label>
        </div>

        <button type="submit" class="btn btn-primary">Spara ändringar</button>
        <a href="/books" class="btn btn-secondary ms-2">Tillbaka</a>
    </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private Book? book;

    protected override async Task OnInitializedAsync()
    {
        book = await Db.Books.FirstOrDefaultAsync(b => b.Id == Id);
    }

    private async Task HandleSubmit()
    {
        if (book != null)
        {
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/books");
        }
    }

}