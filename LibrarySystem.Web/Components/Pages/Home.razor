@page "/"

<h1 class="mb-4">Bibliotekssystem</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Böcker</h5>
                <p class="card-text">Visa och hantera alla böcker.</p>
                <a href="/books" class="btn btn-primary">Visa böcker</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Medlemmar</h5>
                <p class="card-text">Hantera bibliotekets medlemmar.</p>
                <a href="/members" class="btn btn-primary">Visa medlemmar</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Lån</h5>
                <p class="card-text">Se aktiva och tidigare lån.</p>
                <a href="/loans" class="btn btn-primary">Visa lån</a>
            </div>
        </div>
    </div>
</div>