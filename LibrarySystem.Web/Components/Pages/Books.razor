// Books.razor

@page "/books"
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@using Microsoft.EntityFrameworkCore
@inject LibraryContext Db

<h3>Böcker</h3>

<p>
    <a href="/books/add" class="btn btn-primary">Lägg till ny bok</a>
</p>

@if (books == null)
{
    <p>Laddar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>Titel</th>
                <th>Författare</th>
                <th>År</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.ISBN</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishedYear</td>
                    <td>@(book.IsAvailable ? "Tillgänglig" : "Utlånad")</td>
                    <td>
                        <a href="/books/edit/@book.Id" class="btn btn-warning btn-sm me-2">Edit</a>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteBook(book.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    List<Book>? books;

    protected override async Task OnInitializedAsync()
    {
        books = await Db.Books.ToListAsync();
    }

    async Task DeleteBook(int id)
    {
        var book = await Db.Books.FindAsync(id);

        if (book != null)
        {
            Db.Books.Remove(book);
            await Db.SaveChangesAsync();

            books = await Db.Books.ToListAsync();
        }
    }

}