@page "/books"
@using LibrarySystem.Core.Models
@using LibrarySystem.Data
@using Microsoft.EntityFrameworkCore
@inject LibraryContext Db

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Böcker</h3>
        <a href="/books/add" class="btn btn-primary">Lägg till ny bok</a>
    </div>

    @if (books == null)
    {
        <div class="alert alert-info">Laddar böcker...</div>
    }
    else if (!books.Any())
    {
        <div class="alert alert-secondary">Inga böcker hittades.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ISBN</th>
                            <th>Titel</th>
                            <th>Författare</th>
                            <th>År</th>
                            <th>Status</th>
                            <th class="text-end">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in books)
                        {
                            <tr>
                                <td>@book.ISBN</td>
                                <td>@book.Title</td>
                                <td>@book.Author</td>
                                <td>@book.PublishedYear</td>
                                <td>
                                    @if (book.IsAvailable)
                                    {
                                        <span class="badge bg-success">Tillgänglig</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Utlånad</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/books/edit/@book.Id" class="btn btn-warning btn-sm me-2">Redigera</a>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => DeleteBook(book.Id)">
                                        Ta bort
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    List<Book>? books;

    protected override async Task OnInitializedAsync()
    {
        books = await Db.Books.ToListAsync();
    }

    async Task DeleteBook(int id)
    {
        var book = await Db.Books.FindAsync(id);

        if (book != null)
        {
            Db.Books.Remove(book);
            await Db.SaveChangesAsync();

            books = await Db.Books.ToListAsync();
        }
    }
}